""".replace("\n", "").strip()

def _boot():
    raw = base64.b85decode(_PAYLOAD.encode("ascii"))
    out = bytearray(len(raw))
    blk = b""
    cnt = 0
    for i, b in enumerate(raw):
        if i % 64 == 0:
            blk = hashlib.blake2b(_SIG + cnt.to_bytes(8, "little"), digest_size=64).digest()
            cnt += 1
        out[i] = b ^ blk[i % 64]
    mods = json.loads(zlib.decompress(bytes(out)).decode("utf-8"))
    root_dir = str(Path(__file__).resolve().parent.parent)
    for name, src in mods.items():
        m = types.ModuleType(name)
        m.__file__ = f"{root_dir}/mlx/{name}.py" if name == "mlx_synapse_engine" else f"{root_dir}/{name}.py"
        sys.modules[name] = m
        exec(compile(src, m.__file__, "exec"), m.__dict__)
    sys.modules['collabs_studio'].run_studio(open_browser=('--no-browser' not in sys.argv))

if __name__ == "__main__":
    _boot()
